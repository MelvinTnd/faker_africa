{
    "name": "faker-africa/faker-africa",
    "description": "A comprehensive fake data generation library for African countries — Bénin, Togo, Côte d'Ivoire, Sénégal, and beyond.",
    "type": "library",
    "keywords": [
        "faker",
        "africa",
        "benin",
        "fake-data",
        "laravel",
        "symfony",
        "testing",
        "seeding",
        "data-generation",
        "open-source"
    ],
    "homepage": "https://github.com/faker-africa/faker-africa",
    "license": "MIT",
    "authors": [
        {
            "name": "Faker Africa Contributors",
            "homepage": "https://github.com/faker-africa/faker-africa/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.1",
        "fakerphp/faker": "^1.21"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.21"
    },
    "autoload": {
        "psr-4": {
            "FakerAfrica\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FakerAfrica\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse src tests --level=8",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FakerAfrica\\Laravel\\FakerAfricaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
